{
  "name": "patio",
  "version": "0.1.0",
  "private": true,
  "description": "Pátio – rede acadêmica multi-instituição (projeto da disciplina Fábrica de Software)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formatacao": "prettier --check .",
    "tipos": "npm run tipos --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verificar": "npm run formatacao && npm run lint && npm run tipos && npm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
