{
  "expo": {
    "name": "Pátio",
    "slug": "patio",
    "scheme": "patio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.ung.patio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1330",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "br.ung.patio"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pátio",
      "shortName": "Pátio",
      "themeColor": "#2A44C4",
      "backgroundColor": "#F4F5FA"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Pátio usa suas fotos para a foto de perfil, publicações, stories e mensagens."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5FA",
          "dark": {
            "image": "./assets/splash-icon-escuro.png",
            "backgroundColor": "#090C18"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Pátio usa o microfone para gravar mensagens de voz."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d1a52ae2-1477-4ed0-b469-4f34d45e1c1a"
      }
    },
    "owner": "juniorpiresz",
    "backgroundColor": "#F4F5FA",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1a52ae2-1477-4ed0-b469-4f34d45e1c1a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
