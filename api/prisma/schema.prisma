  autor          Usuario         @relation(fields: [instituicaoId, autorId], references: [instituicaoId, id], onDelete: Cascade, map: "imagens_autor_fk")
  // Cada imagem é usada uma vez só (UNIQUE em imagem_id nas três tabelas).
  posts          Post[]          @relation("ImagemDoPost")
  mensagens      Mensagem[]      @relation("ImagemDaMensagem")
  grupoMensagens GrupoMensagem[] @relation("ImagemDoGrupo")
  stories        Story[]

  @@unique([instituicaoId, id], map: "imagens_instituicao_id_key")
  @@index([autorId, criadoEm], map: "imagens_autor_idx")
  @@map("imagens")
}

