model Denuncia {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instituicaoId  String         @map("instituicao_id") @db.Uuid
  denuncianteId  String         @map("denunciante_id") @db.Uuid
  denunciadoId   String         @map("denunciado_id") @db.Uuid
  motivo         MotivoDenuncia
  detalhe        String?        @db.VarChar(500)
  status         StatusDenuncia @default(ABERTA)
  acao           AcaoDenuncia?
  resolvidaPorId String?        @map("resolvida_por_id") @db.Uuid
  resolvidaEm    DateTime?      @map("resolvida_em") @db.Timestamptz(6)
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)

  instituicao  Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  denunciante  Usuario     @relation("Denunciante", fields: [instituicaoId, denuncianteId], references: [instituicaoId, id], onDelete: Cascade, map: "denuncias_denunciante_fk")
  denunciado   Usuario     @relation("Denunciado", fields: [instituicaoId, denunciadoId], references: [instituicaoId, id], onDelete: Cascade, map: "denuncias_denunciado_fk")
