# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.
NODE_ENV=development
PORT=3333
# Origens (separadas por vírgula) autorizadas a chamar a API pelo navegador
CORS_ORIGENS=http://localhost:3000,http://localhost:8081
# Banco principal (desenvolvimento). Com o docker-compose da raiz: usuário/senha patio
DATABASE_URL=postgresql://patio:patio@localhost:5432/patio
# Banco usado só pelos testes: é apagado e recriado a cada execução
DATABASE_URL_TESTE=postgresql://patio:patio@localhost:5432/patio_teste
# Segredo dos tokens de acesso (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes
# E-mail de verdade (opcional). Sem estas duas, o código aparece no terminal.
# Crie a chave em https://app.brevo.com (SMTP & API > API Keys) e verifique o remetente.
# BREVO_API_KEY=
# EMAIL_REMETENTE=seu-email@gmail.com
