# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.
NODE_ENV=development
PORT=3333
# Origens (separadas por vírgula) autorizadas a chamar a API pelo navegador
CORS_ORIGENS=http://localhost:3000
# Banco principal (desenvolvimento). Com o docker-compose da raiz: usuário/senha patio
DATABASE_URL=postgresql://patio:patio@localhost:5432/patio
# Banco usado só pelos testes: é apagado e recriado a cada execução
DATABASE_URL_TESTE=postgresql://patio:patio@localhost:5432/patio_teste
